(defrule rule0
	(test (<http://www.w3.org/2007/rif-builtin-predicate#is-list> (make_list 0 1 2 (make_list 3 4))))
	(test (<http://www.w3.org/2007/rif-builtin-predicate#list-contains> (make_list 0 1 2 3 (make_list 7 8)) (make_list 7 8)))
	(test (eq (<http://www.w3.org/2007/rif-builtin-function#make-list> 0 1 2) (make_list 0 1 2)))
	(test (eq (<http://www.w3.org/2007/rif-builtin-function#count> (make_list 0 1 2 3 4)) 5))
	(test (eq (<http://www.w3.org/2007/rif-builtin-function#get> (make_list 0 1 2 3 4) -1) 4))
	(test (eq (<http://www.w3.org/2007/rif-builtin-function#sublist> (make_list 0 1 2 3 4) 0 5) (make_list 0 1 2 3 4)))
	(test (eq (<http://www.w3.org/2007/rif-builtin-function#append> (make_list 0 1 2) 3 4) (make_list 0 1 2 3 4)))
	(test (eq (<http://www.w3.org/2007/rif-builtin-function#concatenate> (make_list 0 1 2) (make_list 3 4 5)) (make_list 0 1 2 3 4 5)))
	(test (eq (<http://www.w3.org/2007/rif-builtin-function#insert-before> (make_list 0 1 2 3 4) -1 99) (make_list 0 1 2 3 99 4)))
	(test (eq (<http://www.w3.org/2007/rif-builtin-function#remove> (make_list 0 1 2 3 4) -5) (make_list 1 2 3 4)))
	(test (eq (<http://www.w3.org/2007/rif-builtin-function#reverse> (make_list 0 1 2 3 4)) (make_list 4 3 2 1 0)))
	(test (eq (<http://www.w3.org/2007/rif-builtin-function#index-of> (make_list 0 1 2 3 4 5 2 2) 2) (make_list 2 6 7)))
	(test (eq (<http://www.w3.org/2007/rif-builtin-function#union> (make_list 0 1 2 3) (make_list 4)) (make_list 0 1 2 3 4)))
	(test (eq (<http://www.w3.org/2007/rif-builtin-function#distinct-values> (make_list 3 3 3)) (make_list 3)))
	(test (eq (<http://www.w3.org/2007/rif-builtin-function#intersect> (make_list 0 1 2 3 4) (make_list 3 1)) (make_list 1 3)))
	(test (eq (<http://www.w3.org/2007/rif-builtin-function#except> (make_list 0 1 2 3 4) (make_list 1 3)) (make_list 0 2 4)))
	=>
	(<http://white.gobo/ClipsInfoModelRulemachine1#import> "http://example.com/data-ok-import")
)
